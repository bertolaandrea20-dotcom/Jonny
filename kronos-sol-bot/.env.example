# Copia in .env. NON committare mai questo file.

# RPC Solana: quello pubblico è lento e limitato, per il live usa Helius/QuickNode/Triton
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Chiave privata in base58 di un wallet DEDICATO al bot, con solo il capitale da rischiare.
# Mai il tuo wallet Phantom principale.
SOLANA_PRIVATE_KEY=

# Telegram: crea il bot con @BotFather, poi ricava il tuo chat id (es. con @userinfobot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Opzionale, se usi l'endpoint Jupiter con chiave
JUPITER_API_KEY=

# Solo se usi il filtro giornaliero TradingAgents: la chiave del provider LLM scelto
# e le eventuali chiavi dati richieste da TradingAgents (vedi il suo README)
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# ALPHA_VANTAGE_API_KEY=

# Seconda sicurezza per il live: deve essere "yes" oltre a mode: live nel config
CONFIRM_LIVE=no
