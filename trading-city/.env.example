# ── Modalità ──────────────────────────────────────────────
# sim   = mercato sintetico, giorni accelerati (default, nessun rischio)
# paper = prezzi reali, ordini simulati
# live  = prezzi reali, ordini REALI sul broker (servono anche LIVE_CONFIRM)
CITY_MODE=sim

# Sorgente dati: synthetic | real  (real: simboli con '/' via ccxt, gli altri via yfinance)
DATA_SOURCE=synthetic
SYMBOLS=BTC/EUR,ETH/EUR,SOL/EUR,ENI.MI,ISP.MI,UCG.MI,STLAM.MI,RACE.MI

# Broker: paper | ccxt | ibkr
BROKER=paper
CCXT_EXCHANGE=kraken
CCXT_API_KEY=
CCXT_API_SECRET=
IBKR_HOST=127.0.0.1
IBKR_PORT=7497
IBKR_CLIENT_ID=17

# Per il trading reale devi scrivere esattamente questa frase
LIVE_CONFIRM=
MAX_ORDER_EUR=50

# ── Capitale e regole della città ─────────────────────────
CITY_CAPITAL_EUR=10000
TREASURY_SHARE=0.30
INITIAL_CITIZENS=12
MIN_POPULATION=6
MAX_POPULATION=64
LIFESPAN_DAYS=3
PROFIT_TAX=0.10
MIN_CITIZEN_CAPITAL=50

# ── Orologio ──────────────────────────────────────────────
# In sim: quanti tick fanno un "giorno" e quanti secondi dura un tick
DAY_TICKS=48
TICK_SECONDS=0.5
# In paper/live: secondi reali tra un tick e l'altro
LIVE_TICK_SECONDS=900

# ── Ragionamento ──────────────────────────────────────────
# rules  = ragionamento deterministico (gratis)
# claude = Research Manager e Portfolio Manager scritti da Claude
LLM_MODE=rules
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
LLM_MAX_CALLS_PER_DAY=200

DB_PATH=city.db
PORT=8000
