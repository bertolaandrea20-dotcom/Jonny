[
 {
  "id": "n1",
  "text": "Every day, Leo walked home the same way.",
  "voice": "af_heart",
  "speed": 0.9
 },
 {
  "id": "n2",
  "text": "Clink?",
  "voice": "af_heart",
  "speed": 0.9
 },
 {
  "id": "n3",
  "text": "A jacket, as white as nothing at all.",
  "voice": "af_heart",
  "speed": 0.9
 },
 {
  "id": "n4",
  "text": "And Leo was gone.",
  "voice": "af_heart",
  "speed": 0.9
 },
 {
  "id": "n5",
  "text": "Invisible, he could go anywhere.",
  "voice": "af_heart",
  "speed": 0.9
 },
 {
  "id": "n6",
  "text": "Next door, there was a pool that nobody ever swam in,",
  "voice": "af_heart",
  "speed": 0.9
 },
 {
  "id": "n7",
  "text": "and a lady who sat beside it, all alone.",
  "voice": "af_heart",
  "speed": 0.9
 },
 {
  "id": "n8",
  "text": "Leo didn't want to hide any more.",
  "voice": "af_heart",
  "speed": 0.9
 },
 {
  "id": "n9",
  "text": "\"Fancy a swim?\" she asked.",
  "voice": "af_heart",
  "speed": 0.9
 },
 {
  "id": "n10",
  "text": "And the pool was never empty again.",
  "voice": "af_heart",
  "speed": 0.9
 }
]